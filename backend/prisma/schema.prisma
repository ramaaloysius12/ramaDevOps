generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  HADIR
  TERLAMBAT
  IZIN
  ALPHA
}

enum LeaveType {
  TAHUNAN
  SAKIT
  DARURAT
}

model User {
  id              String       @id @default(uuid())
  nik             String       @unique
  name            String
  email           String       @unique
  passwordHash    String
  role            Role         @default(EMPLOYEE)
  position        String
  joinDate        DateTime     @default(now())
  baseSalary      Float
  isActive        Boolean      @default(true)
  photoUrl        String?
  departmentId    String
  department      Department   @relation(fields: [departmentId], references: [id])
  attendances     Attendance[]
  leaves          Leave[]
  overtimes       Overtime[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Department {
  id         String   @id @default(uuid())
  name       String
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  users      User[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Location {
  id          String       @id @default(uuid())
  name        String
  address     String
  lat         Float
  lng         Float
  radius      Float        // Dalam meter
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Attendance {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  date          DateTime         @db.Date
  checkInTime   DateTime?
  checkInPhoto  String?
  checkInLat    Float?
  checkInLng    Float?
  checkOutTime  DateTime?
  checkOutPhoto String?
  status        AttendanceStatus
  workingHours  Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, date])
}

model Leave {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       LeaveType
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  reason     String
  attachment String?
  status     Status    @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Overtime {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        DateTime  @db.Date
  startTime   DateTime
  endTime     DateTime
  description String
  status      Status    @default(PENDING)
  totalPay    Float?
  approvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
